@model _1294372_Master_Details.Models.Entity.Service

@{
    ViewData["Title"] = "Delete Service";
}

<style>
    .delete-card {
        max-width: 520px;
        margin: auto;
        border-radius: 24px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 20px 45px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .delete-header {
        background: linear-gradient(135deg, #dc3545, #fa5252);
        color: #fff;
        padding: 28px;
        text-align: center;
    }

        .delete-header h3 {
            font-weight: 800;
            margin-bottom: 6px;
        }

    .delete-body {
        padding: 30px;
    }

    .danger-box {
        background: linear-gradient(135deg, #ffe3e3, #fff5f5);
        border-left: 4px solid #fa5252;
        padding: 14px 16px;
        border-radius: 12px;
        margin-bottom: 24px;
    }

    .btn-soft {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 26px;
    }
</style>

<div class="container py-4">

    <div class="delete-card">

        <!-- Header -->
        <div class="delete-header">
            <div style="font-size:42px;">⚠</div>
            <h3>Confirm Delete</h3>
            <p class="mb-0 opacity-75">
                This action cannot be undone
            </p>
        </div>

        <!-- Body -->
        <div class="delete-body">

            <div class="danger-box">
                <strong>Service Name:</strong>
                <div class="fw-semibold mt-1">
                    @Model.ServiceName
                </div>
            </div>

            <p class="text-muted mb-4">
                Are you sure you want to permanently delete this service?
            </p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="ServiceId" />

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-soft">
                        ← Cancel
                    </a>

                    <button type="submit" class="btn btn-danger btn-soft shadow-sm">
                        🗑 Yes, Delete
                    </button>
                </div>
            </form>

        </div>

    </div>

</div>