@model _1294372_Master_Details.Models.Entity.Service

@{
    ViewData["Title"] = "Edit Service";
}

<style>
    .form-card {
        max-width: 520px;
        margin: auto;
        border-radius: 24px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 20px 45px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .form-header {
        background: linear-gradient(135deg, #0d6efd, #4dabf7);
        color: #fff;
        padding: 30px;
        text-align: center;
    }

        .form-header h3 {
            font-weight: 800;
            margin-bottom: 6px;
        }

    .form-body {
        padding: 30px;
    }

    .form-control {
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 500;
    }

    .btn-soft {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 26px;
    }
</style>

<div class="container py-4">

    <div class="form-card">

        <!-- Header -->
        <div class="form-header">
            <div style="font-size:38px;">✏</div>
            <h3>Edit Service</h3>
            <p class="mb-0 opacity-75">
                Update service information
            </p>
        </div>

        <!-- Form -->
        <div class="form-body">
            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="ServiceId" />

                <div class="mb-4">
                    <label asp-for="ServiceName" class="form-label fw-semibold"></label>
                    <input asp-for="ServiceName"
                           class="form-control"
                           placeholder="Update service name" />
                    <span asp-validation-for="ServiceName"
                          class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-soft">
                        ← Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary btn-soft shadow-sm">
                        💾 Save Changes
                    </button>
                </div>

            </form>
        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}