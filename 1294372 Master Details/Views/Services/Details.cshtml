@model _1294372_Master_Details.Models.Entity.Service

@{
    ViewData["Title"] = "Service Details";
}

<style>
    .details-card {
        max-width: 520px;
        margin: auto;
        border-radius: 24px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 20px 45px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .details-header {
        background: linear-gradient(135deg, #0d6efd, #4dabf7);
        color: #fff;
        padding: 30px;
        text-align: center;
    }

        .details-header h3 {
            font-weight: 800;
            margin-bottom: 6px;
        }

    .details-body {
        padding: 30px;
    }

    .info-box {
        background: #f8fafc;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 20px;
        border: 1px solid rgba(0,0,0,0.05);
    }

        .info-box small {
            text-transform: uppercase;
            font-size: 0.7rem;
            font-weight: 600;
            color: #6b7280;
        }

    .btn-soft {
        border-radius: 999px;
        font-weight: 600;
        padding: 10px 26px;
    }
</style>

<div class="container py-4">

    <div class="details-card">

        <!-- Header -->
        <div class="details-header">
            <div style="font-size:38px;">🔍</div>
            <h3>Service Details</h3>
            <p class="mb-0 opacity-75">
                View service information
            </p>
        </div>

        <!-- Body -->
        <div class="details-body">

            <div class="info-box">
                <small>Service Name</small>
                <div class="fw-semibold fs-5">
                    @Model.ServiceName
                </div>
            </div>

            <div class="info-box">
                <small>Service ID</small>
                <div class="fw-semibold">
                    #@Model.ServiceId
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-soft">
                    ← Back
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.ServiceId"
                   class="btn btn-primary btn-soft shadow-sm">
                    ✏ Edit Service
                </a>
            </div>

        </div>

    </div>

</div>