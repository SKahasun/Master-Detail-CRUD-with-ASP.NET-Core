@model CustomerVM
@{
    ViewData["Title"] = "Delete Customer";
}

<style>
    .delete-card {
        background: #fff;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .danger-box {
        background: #fff5f5;
        border-left: 5px solid #fa5252;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .profile-box {
        background: linear-gradient(135deg, #fa5252, #ff8787);
        color: #fff;
        border-radius: 20px;
        padding: 25px;
        text-align: center;
    }

    .profile-img {
        width: 250px;
        height: 450px;
        object-fit: cover;
        object-position: top;
        border-radius: 20px;
        border: 4px solid rgba(255,255,255,0.6);
        margin-bottom: 12px;
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #6b7280;
    }

    .btn-modern {
        border-radius: 999px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .service-table {
        font-size: 0.9rem;
    }
</style>

<div class="container py-4">

    <form asp-action="Delete"
          asp-controller="Customer"
          onsubmit="return confirm('⚠ This action is permanent. Do you really want to delete this customer?')">

        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="DevicePicture" />

        <div class="row g-4">

            <!-- LEFT PROFILE -->
            <div class="col-lg-4">
                <div class="profile-box">

                    <img src="@Model.DevicePicture" class="profile-img" />

                    <h5 class="fw-bold">@Model.CustomerName</h5>

                    @if (Model.IsRegular)
                    {
                        <span class="badge bg-light text-dark">⭐ Regular</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark">Guest</span>
                    }

                    <div class="mt-3">
                        <div><strong>@Model.DeviceName</strong></div>
                        <small>@Model.Phone</small>
                    </div>

                </div>
            </div>

            <!-- RIGHT DETAILS -->
            <div class="col-lg-8">
                <div class="delete-card">

                    <h3 class="text-danger fw-bold mb-3">⚠ Delete Confirmation</h3>

                    <div class="danger-box">
                        <strong>This action cannot be undone.</strong><br />
                        Deleting this customer will remove all related service history permanently.
                    </div>

                    <!-- Info -->
                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="info-label">Device Age</div>
                            <div class="fw-semibold">@Model.DeviceAge Years</div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-label">Entry Date</div>
                            <div class="fw-semibold">@Model.EntryDate.ToShortDateString()</div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-label">Buying Date</div>
                            <div class="fw-semibold">@Model.BuyingDate.ToShortDateString()</div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-label">Address</div>
                            <div class="fw-semibold">@Model.Address</div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded">
                                <div class="info-label text-danger fw-bold">Problem</div>
                                <div class="text-danger fw-semibold">@Model.Problem</div>
                            </div>
                        </div>

                    </div>

                    <!-- Service List -->
                    <div class="mt-4">
                        <h6 class="fw-bold mb-2">Service List</h6>

                        <table class="table table-sm table-bordered service-table">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Service Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ServiceList)
                                {
                                    <tr>
                                        <td>#@item</td>
                                        <td>Service @item</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Buttons -->
                    <div class="mt-4 d-flex gap-3">
                        <button type="submit" class="btn btn-danger btn-modern">
                            🗑 Confirm Delete
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary btn-modern">
                            Cancel
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </form>
</div>