@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .page-header h2 {
            font-weight: 800;
            letter-spacing: -0.5px;
        }

    .customer-card {
        border-radius: 22px;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .customer-card:hover {
            transform: translateY(-6px) scale(1.01);
            box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        }

    .left-panel {
        background: linear-gradient(135deg, #0d6efd, #4dabf7);
        color: #fff;
        padding: 25px;
        text-align: center;
    }

    .avatar {
        
        border-radius: 20px;
        border: 4px solid rgba(255,255,255,0.6);
        margin-bottom: 15px;
        object-fit: cover;
        object-position: top;
        width: 120px;
        height: 120px; /* change this *
        background: #f1f1f1; /* optional */
    }

    .badge-soft {
        background: rgba(255,255,255,0.2);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.8rem;
    }

    .info-box small {
        color: #6b7280;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
    }

    .problem-box {
        background: linear-gradient(135deg, #ffe3e3, #fff5f5);
        border-left: 4px solid #fa5252;
        padding: 12px 14px;
        border-radius: 10px;
    }

    .service-table {
        font-size: 0.85rem;
    }

        .service-table tr:hover {
            background: #f8f9fa;
        }

    .btn-soft {
        border-radius: 999px;
        font-weight: 600;
    }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h2 class="text-primary">Customer Dashboard</h2>
            <p class="text-muted mb-0">Manage devices, services & customer records</p>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-soft px-4 shadow-sm">
            + Add Customer
        </a>
    </div>

    <!-- Cards -->
    <div class="row g-4">
        @foreach (var clnt in Model)
        {
            <div class="col-lg-12">
                <div class="customer-card">

                    <div class="row g-0">

                        <!-- LEFT PANEL -->
                        <div class="col-md-3 left-panel">
                            <img src="@clnt.DevicePicture" class="avatar" />

                            <h5 class="fw-bold">@clnt.CustomerName</h5>

                            <div class="mb-3">
                                @if (clnt.IsRegular)
                                {
                                    <span class="badge-soft">⭐ Regular</span>
                                }
                                else
                                {
                                    <span class="badge-soft">Guest</span>
                                }
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-action="Edit" asp-route-id="@clnt.CustomerId"
                                   class="btn btn-light btn-sm btn-soft">
                                    Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@clnt.CustomerId"
                                   class="btn btn-outline-light btn-sm btn-soft">
                                    Delete
                                </a>
                            </div>
                        </div>

                        <!-- MIDDLE INFO -->
                        <div class="col-md-5 p-4">

                            <div class="row g-3 info-box">

                                <div class="col-6">
                                    <small>Device</small>
                                    <div class="fw-semibold">@clnt.DeviceName</div>
                                </div>

                                <div class="col-6">
                                    <small>Phone</small>
                                    <div class="fw-semibold">@clnt.Phone</div>
                                </div>

                                <div class="col-6">
                                    <small>Device Age</small>
                                    <div class="fw-semibold">@clnt.DeviceAge Years</div>
                                </div>

                                <div class="col-6">
                                    <small>Entry Date</small>
                                    <div class="fw-semibold">@clnt.EntryDate.ToShortDateString()</div>
                                </div>

                                <div class="col-12 mt-3">
                                    <div class="problem-box">
                                        <small class="text-danger fw-bold">Problem</small>
                                        <div class="fw-semibold text-danger">@clnt.Problem</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <small>Address</small>
                                    <div>@clnt.Address</div>
                                </div>

                            </div>
                        </div>

                        <!-- RIGHT PANEL -->
                        <div class="col-md-4 p-4 border-start">

                            <h6 class="fw-bold mb-3">Service History</h6>

                            <table class="table service-table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Service</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in clnt.ServiceEntries)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">
                                                #@item.Service.ServiceId
                                            </td>
                                            <td>@item.Service.ServiceName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>

                    </div>

                </div>
            </div>
        }
    </div>
</div>